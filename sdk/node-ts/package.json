{
  "name": "microsandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superradcompany/microsandbox.git",
    "directory": "sdk/node-ts"
  },
  "version": "0.7.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./native/index.d.ts",
      "default": "./native/index.cjs"
    }
  },
  "bin": {
    "microsandbox": "bin/microsandbox.cjs",
    "msb": "bin/microsandbox.cjs"
  },
  "napi": {
    "binaryName": "microsandbox",
    "packageName": "@superradcompany/microsandbox",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build:native": "napi build --release --platform --js index.cjs --dts index.d.ts --output-dir native",
    "postbuild:native": "npm run typecheck:native",
    "build:native:ci": "napi build --profile ci --platform --js index.cjs --dts index.d.ts --output-dir native",
    "postbuild:native:ci": "npm run typecheck:native",
    "build:native:debug": "napi build --platform --js index.cjs --dts index.d.ts --output-dir native",
    "postbuild:native:debug": "npm run typecheck:native",
    "build:ts": "npm run build --workspace @microsandbox/types && tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "build:ci": "npm run build:native:ci && npm run build:ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:native",
    "typecheck:native": "tsc --noEmit --skipLibCheck false --target ES2022 --moduleResolution NodeNext --module NodeNext native/index.d.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "@types/node": "^25.5.2",
    "typescript": "^5.6",
    "vitest": "^5.0"
  },
  "optionalDependencies": {
    "@superradcompany/microsandbox-darwin-arm64": "0.7.4",
    "@superradcompany/microsandbox-linux-arm64-gnu": "0.7.4",
    "@superradcompany/microsandbox-linux-x64-gnu": "0.7.4",
    "@superradcompany/microsandbox-win32-arm64-msvc": "0.7.4",
    "@superradcompany/microsandbox-win32-x64-msvc": "0.7.4"
  },
  "files": [
    "dist",
    "native/index.cjs",
    "native/index.d.ts",
    "bin/microsandbox.cjs",
    "README.md"
  ],
  "dependencies": {
    "@microsandbox/types": "0.7.4"
  },
  "workspaces": [
    "../../packages/microsandbox-types/typescript"
  ]
}
