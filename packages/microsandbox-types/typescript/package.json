{
  "name": "@microsandbox/types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superradcompany/microsandbox.git",
    "directory": "packages/microsandbox-types/typescript"
  },
  "version": "0.7.4",
  "type": "module",
  "main": "./dist/cloud.js",
  "types": "./dist/cloud.d.ts",
  "exports": {
    "./size": {
      "types": "./dist/size.d.ts",
      "import": "./dist/size.js"
    },
    ".": {
      "types": "./dist/cloud.d.ts",
      "import": "./dist/cloud.js"
    }
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
